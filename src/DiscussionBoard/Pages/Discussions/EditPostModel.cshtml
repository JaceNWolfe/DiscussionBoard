@page "/Discussion/{threadId:int}/Post/Edit/{postId:int}"
@model DiscussionBoard.Pages.Discussions.EditPostModel

@{
    ViewData["Title"] = "Edit Post";
}

<h1>Edit Post</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.Title" class="form-label"></label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Content" class="form-label"></label>
        <textarea asp-for="Input.Content"
                  class="form-control"
                  rows="6"></textarea>
        <span asp-validation-for="Input.Content" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

    <a asp-page="/Discussions/Details"
       asp-route-threadId="@RouteData.Values["threadId"]"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
