
@page "/Discussion/{threadId:int}"
@using DiscussionBoard.Services
@model DiscussionBoard.Pages.Discussions.Details

@{
    ViewData["Title"] = Model.Thread?.Title ?? "Discussion";
}

@if (Model.Thread != null)
{
    <div class="d-flex justify-content-between align-items-center">
        <h1>@Model.Thread.Title</h1>

        @if (Model.CanEditThread)
        {
            <a asp-page="/Discussions/Edit"
               asp-route-id="@Model.Thread.Id"
               class="btn btn-outline-primary">
                Edit Discussion
            </a>
        }
    </div>

    <p>@Model.Thread.Content</p>

    <small class="text-muted">
        @{
            var displayName = string.IsNullOrWhiteSpace(Model.Thread.ApplicationUser?.DisplayName)
                ? "Unconfigured User"
                : Model.Thread.ApplicationUser.DisplayName;

            var avatarPath = AvatarCatalog.ImagePath(Model.Thread.ApplicationUser?.AvatarId);
        }

        <div class="d-flex align-items-center gap-2">
            <img src="@avatarPath"
                 alt="@($"{displayName}'s avatar")"
                 width="40"
                 height="40"
                 class="rounded-circle" />

            <small class="text-muted">
                Started by @displayName —
                @Model.Thread.CreatedAt.ToLocalTime().ToString("g")
            </small>
        </div>
    </small>

    <hr />

    @if (User.Identity?.IsAuthenticated == true)
    {
        <h2>Reply to Discussion</h2>

        <form method="post"
              asp-page-handler="Reply"
              asp-route-threadId="@Model.Thread.Id">

            <div asp-validation-summary="All"
                 class="text-danger"></div>

            <input type="hidden"
                   name="Input.ParentPostId"
                   value="" />

            <div class="mb-3">
                <label asp-for="Input.Content"
                       class="form-label">Your reply</label>

                <textarea asp-for="Input.Content"
                          class="form-control"
                          rows="4"
                          required
                          maxlength="10000"></textarea>

                <span asp-validation-for="Input.Content"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Post Reply
            </button>
        </form>

        <hr />
    }
    else
    {
        <p><a asp-area="Identity" asp-page="/Account/Login">
            Sign in</a> to reply to this discussion.</p>
    }

    <h2>Posts and Replies</h2>

    @if (Model.RootPosts.Count == 0)
    {
        <p>No replies yet. Start the conversation!</p>
    }
    else
    {
        @foreach (var node in Model.RootPosts)
        {
            <partial name="/Pages/Discussions/_PostTree.cshtml"
                     model="node" />
        }
    }

    <a asp-page="/Forums/Details"
       asp-route-id="@Model.Thread.ForumId"
       class="btn btn-secondary mt-3">
        Back to Forum
    </a>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
