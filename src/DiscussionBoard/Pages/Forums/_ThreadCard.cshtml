@model DiscussionBoard.Models.DiscussionThread
@using DiscussionBoard.Services

@{
    var displayName = string.IsNullOrWhiteSpace(Model.ApplicationUser?.DisplayName)
        ? "Unconfigured User"
        : Model.ApplicationUser.DisplayName;

    var avatarPath = AvatarCatalog.ImagePath(Model.ApplicationUser?.AvatarId);
}

<article class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">
            <a asp-page="/Discussions/Details"
               asp-route-threadId="@Model.Id">
                @Model.Title
            </a>
        </h5>

        <p class="card-text">@Model.Content</p>

        <div class="d-flex align-items-center gap-2 mb-2">
            <img src="@avatarPath"
                 alt="@($"{displayName}'s avatar")"
                 width="40"
                 height="40"
                 class="rounded-circle" />
            <span>@displayName</span>
        </div>

        <small class="text-muted">
            Created: @Model.CreatedAt.ToLocalTime().ToString("g")
        </small>

        <div class="mt-3">
            <a asp-page="/Discussions/Details"
               asp-route-threadId="@Model.Id"
               class="btn btn-primary btn-sm">
                View Discussion
            </a>

            @if (User.Identity?.IsAuthenticated == true &&
                 User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                 == Model.ApplicationUserId)
            {
                <a asp-page="/Discussions/Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-secondary btn-sm">
                    Edit
                </a>
            }
        </div>
    </div>
</article>
