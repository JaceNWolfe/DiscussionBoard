@page
@model DiscussionBoard.Pages.Admin.UsersModel

@{
    ViewData["Title"] = "Manage Users";
}

<h1>Manage Users</h1>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info" role="alert">
        @Model.Message
    </div>
}

<form method="post" asp-page-handler="SelectUser">
    <div class="mb-3">
        <label asp-for="SelectedUserId" class="form-label">
            Select User
        </label>

        <select asp-for="SelectedUserId"
                asp-items="Model.UserOptions"
                class="form-select">
            <option value="">-- Select User --</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">
        Select User
    </button>
</form>

@if (Model.SelectedUser != null)
{
    <hr />

    <h2>User Details</h2>

    <p><strong>Display Name:</strong> @Model.SelectedUser.DisplayName</p>
    <p><strong>Email:</strong> @Model.SelectedUser.Email</p>

    <form method="post" asp-page-handler="UpdateRole">
        <input type="hidden"
               asp-for="SelectedUserId" />

        <input type="hidden"
               asp-for="RoleName"
               value="@DiscussionBoard.Authorization.ApplicationRoles.Admin" />

        @if (Model.IsAdmin)
        {
            <input type="hidden" asp-for="RoleAction" value="Remove" />

            <button type="submit" class="btn btn-danger">
                Remove Admin Role
            </button>
        }
        else
        {
            <input type="hidden" asp-for="RoleAction" value="Add" />

            <button type="submit" class="btn btn-success">
                Add Admin Role
            </button>
        }
    </form>
}
